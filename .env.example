NODE_ENV=development
PORT=3000

# Supabase project settings. The database connection is under Project Settings > Database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me
DATABASE_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_BASE_URL=http://localhost:3000

# Optional staging account bootstrap. Store real account details only in a
# private local/deployment environment, never commit them to source control.
# Values are JSON arrays; passwords must be unique per account and >=12 chars.
TEACHFOLIO_SEED_INSTITUTIONS=
TEACHFOLIO_SEED_ACCOUNTS=

# Resend transactional mail. Use a sender address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Teachfolio <noreply@your-verified-domain.example>"

# Create a private bucket with this name in Supabase Storage.
SUPABASE_STORAGE_BUCKET=teachfolio-evidence
